# cp .env.example .env，然后至少把 TIDE_USERS 里的口令改掉。

# 用户表，一条 `用户名:口令`，多条用逗号或换行分隔。
# 用户名只用于服务端日志与规则匹配，客户端不需要填；口令才是凭据——
# TIDE 把它派生成 16 字节 user_id（SHA-256 折叠，不是截断：截断会让两个前 16 字节
# 相同的口令塌成同一个用户且不报错）。
#
# ★ 这个值**不会**被塞进容器的环境变量。编排把它作为 secret 写成容器内的
#   /run/secrets/tide_users，服务端用 TIDE_USERS_FILE 去读。
#   环境变量里的口令会出现在 docker inspect 和 /proc/<pid>/environ 里，
#   而这里的口令等于代理的钥匙。
TIDE_USERS=alice:change-me-before-you-deploy

# 对外端口，TCP 与 UDP 用同一个。
# 改这一项是安全的：编排会把同一个值也传给容器（TIDE_ADVERTISE_PORT），
# 所以启动横幅里那段客户端配置的 port: 会跟着变。
TIDE_PORT=8443

# 外层 TLS 的 SNI，必须与证书一致。用自动生成的自签证书时保持 tide.local 即可；
# 换成真证书后改成你的真实域名，并把客户端的 skip-cert-verify 删掉。
TIDE_SNI=tide.local

# 只影响启动时打印的示例配置，填你的服务器域名或 IP。
TIDE_ADVERTISE=

# 外层 TLS 通告的 ALPN，逗号分隔。
#
# ★ 必须是**掩护源站真会说的协议**，不是"哪个好看"。失败关闭时应答主动探测方的
#   是掩护源站：谈成了 h2、而掩护源站只会 HTTP/1.1 的话，探测方会拿到
#   "协商了 h2，却回了一句 HTTP/1.1 400"——真 h2 服务端永远不会这样，
#   这个特征比"不通告 ALPN"强得多，而且代理功能一切正常、毫无症状。
#   本编排自带的掩护源站是 nginx 默认站点，只会 HTTP/1.1，所以默认值就是 http/1.1。
#   掩护源站真开了 h2c（nginx: listen 80 http2;）再改成 h2,http/1.1。
#   服务端启动时会实际探一次掩护源站，不一致就告警。
TIDE_COVER_ALPN=http/1.1

# 构建镜像时拉 Go 依赖用的代理。官方 proxy.golang.org 在部分网络里连不上，
# 那种情况下改成 https://goproxy.cn,direct（或你自己的私有源）。
GOPROXY=https://proxy.golang.org,direct

# 所有路径都断掉后会话的存活时间。调大 = 更长的断网也能无缝续上，
# 代价是服务端要为不在线的客户端多留一会儿上游连接和缓冲区。
TIDE_GRACE=120s

# QUIC 面改走 HTTP/3（spec §12.6）。非空即开启。
# ★ 两端必须一致：客户端也要开 h3，否则 QUIC 通道会**静默失效**（没有任何报错）。
TIDE_H3=
