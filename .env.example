# cp .env.example .env，然后至少把 TIDE_PASSWORD 改掉。

# 客户端连接用的口令。TIDE 把它派生成 16 字节 user_id（SHA-256 折叠，
# 不是截断——截断会让两个前 16 字节相同的口令塌成同一个用户且不报错）。
TIDE_PASSWORD=change-me-before-you-deploy

# 用户名只用于服务端日志与规则匹配，客户端不需要填。
TIDE_USER=alice

# 对外端口，TCP 与 UDP 用同一个。
TIDE_PORT=8443

# 外层 TLS 的 SNI，必须与证书一致。用自动生成的自签证书时保持 tide.local 即可；
# 换成真证书后改成你的真实域名，并把客户端的 skip-cert-verify 删掉。
TIDE_SNI=tide.local

# 只影响启动时打印的示例配置，填你的服务器域名或 IP。
TIDE_ADVERTISE=

# 构建镜像时拉 Go 依赖用的代理。官方 proxy.golang.org 在部分网络里连不上，
# 那种情况下改成 https://goproxy.cn,direct（或你自己的私有源）。
GOPROXY=https://proxy.golang.org,direct

# 所有路径都断掉后会话的存活时间。调大 = 更长的断网也能无缝续上，
# 代价是服务端要为不在线的客户端多留一会儿上游连接和缓冲区。
TIDE_GRACE=120s

# QUIC 面改走 HTTP/3（spec §12.6）。非空即开启。
# ★ 两端必须一致：客户端也要开 h3，否则 QUIC 通道会**静默失效**（没有任何报错）。
TIDE_H3=
